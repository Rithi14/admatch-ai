# Copy this file to ".env" (same folder) to change these values.
# Vite only exposes variables that start with VITE_.

# Base URL of the future Python FastAPI backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Keep "false" to use the built-in DEMO analysis + browser localStorage.
# Set to "true" once the FastAPI backend is running.
VITE_USE_BACKEND=false
